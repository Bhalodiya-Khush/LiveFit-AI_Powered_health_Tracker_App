# LiveFit Backend Environment Variables Template
# Copy this to .env locally or set these in Render / Deployment Dashboard

# Server port (Render will inject PORT automatically)
PORT=5050

# MongoDB Connection String:
# Local development: mongodb://127.0.0.1:27017/livefit_db
# Production (MongoDB Atlas): mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/livefit_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/livefit_db

# JWT Authentication Secret Key (use a long secure random string in production)
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini AI API Key (from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
